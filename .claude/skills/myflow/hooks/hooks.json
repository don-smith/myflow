{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "description": "Forward tool-use events to Langfuse for observability. Requires LANGFUSE_HOST, LANGFUSE_PUBLIC_KEY, and LANGFUSE_SECRET_KEY env vars.",
            "url": "${LANGFUSE_HOST:-http://localhost:3000}/api/public/otel/v1/traces",
            "headers": {
              "Authorization": "Basic ${LANGFUSE_PUBLIC_KEY:-}:${LANGFUSE_SECRET_KEY:-}",
              "Content-Type": "application/json"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "description": "Flush pending spans on session stop.",
            "url": "${LANGFUSE_HOST:-http://localhost:3000}/api/public/otel/v1/traces",
            "headers": {
              "Authorization": "Basic ${LANGFUSE_PUBLIC_KEY:-}:${LANGFUSE_SECRET_KEY:-}",
              "Content-Type": "application/json"
            }
          }
        ]
      }
    ]
  }
}