{
  "name": "myflow",
  "version": "3.0.0",
  "description": "myflow — a single 5-stage pipeline for AI-assisted software development, from discovery through landing.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "myflow",
    "skills",
    "workflow",
    "landing",
    "closeout"
  ],
  "license": "MIT",
  "author": "Don Smith",
  "type": "module",
  "files": [
    "LICENSE",
    "README.md",
    "docs/artifact-and-stage-boundary-contract.md",
    "docs/myflow-workflow-status-and-alignment.md",
    "skills",
    "packages/config",
    "packages/ask-user-question",
    "packages/telemetry",
    "packages/web-tools",
    "!packages/**/node_modules",
    "!packages/**/*.test.ts",
    "!packages/**/test",
    "!packages/**/docs",
    "!skills/**/*.test.*",
    "!packages/**/CHANGELOG.md",
    "!packages/**/vitest.config.ts"
  ],
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/don-smith/myflow.git"
  },
  "homepage": "https://github.com/don-smith/myflow#readme",
  "bugs": {
    "url": "https://github.com/don-smith/myflow/issues"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./packages/ask-user-question/index.ts",
      "./packages/telemetry/extension.ts",
      "./packages/web-tools/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@langfuse/client": "^5.9.1",
    "@langfuse/otel": "^5.9.1",
    "@langfuse/tracing": "^5.9.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@tintinweb/pi-subagents": "*",
    "yaml": "*"
  },
  "scripts": {
    "lint": "echo 'No lint configured yet'",
    "test": "bun run test:root && bun run test:packages",
    "test:root": "node --test tests/*.test.mjs",
    "test:packages": "bun run --filter @myflow/test-utils --filter @myflow/ask-user-question --filter @myflow/web-tools --filter @myflow/telemetry test"
  },
  "devDependencies": {
    "vitest": "*"
  }
}
