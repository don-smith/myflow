{
  "name": "myflow",
  "version": "4.0.0",
  "description": "MyFlow: an artifact-led, five-stage workflow for AI-assisted software development. Scope, Plan, Implement, Verify, Close.",
  "keywords": [
    "pi-package",
    "myflow",
    "skills",
    "workflow",
    "planning",
    "code-review",
    "artifacts"
  ],
  "license": "MIT",
  "author": "Don Smith",
  "type": "module",
  "bin": {
    "myflow": "skills/myflow/scripts/cli.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "plugin.json",
    ".claude-plugin/plugin.json",
    ".claude-plugin/marketplace.json",
    ".agents/plugins/marketplace.json",
    "docs/artifact-and-stage-boundary-contract.md",
    "docs/myflow-workflow-status-and-alignment.md",
    "skills",
    "!skills/**/*.test.*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/don-smith/myflow.git"
  },
  "homepage": "https://github.com/don-smith/myflow#readme",
  "bugs": {
    "url": "https://github.com/don-smith/myflow/issues"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "lint": "echo 'No lint configured yet'",
    "test": "node --test tests/*.test.mjs skills/code-review/_helpers/review-range.test.mjs"
  }
}
