{
	"name": "@myflow/telemetry",
	"version": "1.19.1",
	"private": true,
	"description": "Pi extension. Langfuse observability and evaluation for Pi Agent — auto-instruments lifecycle events and scores workflow friction.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"rpiv",
		"telemetry",
		"langfuse",
		"observability",
		"tracing"
	],
	"type": "module",
	"license": "MIT",
	"author": "juicesharp",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/don-smith/myflow.git",
